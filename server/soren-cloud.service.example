[Unit]
Description=Soren Cloud API
After=network.target

[Service]
Type=simple
User=soren
Group=soren
WorkingDirectory=/opt/soren-cloud/server
EnvironmentFile=/etc/soren-cloud.env
ExecStart=/usr/bin/node /opt/soren-cloud/server/index.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
